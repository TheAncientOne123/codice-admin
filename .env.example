# Copia a .env.local y rellena. No subas .env.local a git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: solo para los scripts locales (cargar instantánea, crear admin). Nunca en Vercel.
SUPABASE_SECRET_KEY=sb_secret_...

# Login: el usuario que escribes se traduce a este email de Supabase.
ADMIN_USERNAME=
ADMIN_EMAIL=

# Despliegue de El Códice (GitHub Actions). PAT fine-grained con "Actions: Read and write"
# solo sobre el repo authorsite2.
GITHUB_TOKEN=
GITHUB_REPO=TheAncientOne123/authorsite2
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main

# URL pública de El Códice (para enlaces "Ver en el sitio").
NEXT_PUBLIC_SITE_URL=https://theancientone123.github.io/authorsite2
